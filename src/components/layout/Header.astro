---
import { siteConfig } from '@/config/site.config';
import { CartNavLink } from '../cart/CartNavLink';

const path = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a class="header__brand" href="/" aria-label={`${siteConfig.shortName} — home`}>
      <img
        class="header__logo"
        src="/logo.png"
        alt=""
        width="1190"
        height="1190"
        decoding="async"
        fetchpriority="high"
      />
    </a>
    <button
      type="button"
      class="header__toggle"
      aria-expanded="false"
      aria-controls="site-nav"
      id="nav-toggle"
    >
      Menu
    </button>
    <nav class="header__nav" id="site-nav" aria-label="Principale">
      <ul class="header__list">
        {
          siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['header__link', { 'is-active': path.startsWith(item.href) }]}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="header__cart-wrap">
          <CartNavLink client:load />
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-height);
    padding-block: var(--space-sm);
    gap: var(--space-md);
  }

  .header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    line-height: 0;
    text-decoration: none;
    color: inherit;
  }

  .header__logo {
    display: block;
    width: auto;
    height: auto;
    max-height: var(--header-logo-max);
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 768px) {
    .header__logo {
      max-height: 3.5rem;
    }
  }

  .header__toggle {
    display: flex;
    min-height: var(--touch-min);
    padding: 0 var(--space-md);
    font: inherit;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
  }

  .header__nav {
    display: none;
  }

  .header__nav.is-open {
    display: block;
    position: absolute;
    left: calc(-1 * var(--container-padding-inline));
    right: calc(-1 * var(--container-padding-inline));
    width: calc(100% + 2 * var(--container-padding-inline));
    top: var(--header-height);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) var(--container-padding-inline);
  }

  .header__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .header__link,
  .header__cart {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: 0 var(--space-sm);
    text-decoration: none;
    font-weight: 500;
    color: var(--color-text);
    border-radius: var(--radius-sm);
  }

  .header__link:hover,
  .header__cart:hover {
    color: var(--color-primary);
    background: var(--color-bg);
  }

  .header__link.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .header__cart {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .header {
      position: relative;
    }

    .header__toggle {
      display: none;
    }

    .header__nav {
      display: block;
      position: static;
      padding: 0;
      border: none;
    }

    .header__list {
      flex-direction: row;
      align-items: center;
      gap: var(--space-md);
    }
  }
</style>
