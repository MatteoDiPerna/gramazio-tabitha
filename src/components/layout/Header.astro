---
import { siteConfig } from '@/config/site.config';
import { CartNavLink } from '../cart/CartNavLink';

const path = Astro.url.pathname;
---

<header class="header header--overlay layout-bleed">
  <div class="site-rail site-rail--header header__inner">
    <a class="header__brand" href="/" aria-label={`${siteConfig.shortName} — home`}>
      <img
        class="header__logo"
        src="/logo.png"
        alt=""
        width="1190"
        height="1190"
        decoding="async"
        fetchpriority="high"
      />
    </a>
    <nav class="header__nav" id="site-nav" aria-label="Principale">
      <ul class="header__list">
        {
          siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['header__link', { 'is-active': path.startsWith(item.href) }]}
                aria-current={path.startsWith(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="header__actions">
      <CartNavLink client:load />
      <button
        type="button"
        class="header__toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        id="nav-toggle"
      >
        Menu
      </button>
    </div>
  </div>
</header>

<script>
  import { initHeaderScroll } from '@/scripts/headerScroll';

  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    initHeaderScroll();
  });

  initHeaderScroll();
  document.addEventListener('astro:page-load', initHeaderScroll);
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .header.header--overlay:not(.header--solid) {
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  .header.header--solid {
    background: var(--color-surface);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.04);
  }

  .header.header--overlay:not(.header--solid) .header__link {
    color: #fff;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.45);
  }

  .header.header--overlay:not(.header--solid) .header__link:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.12);
  }

  .header.header--overlay:not(.header--solid) .header__link.is-active {
    color: #fff;
    font-weight: 600;
  }

  .header.header--overlay:not(.header--solid) .header__toggle {
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.55);
  }

  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--header-height);
    padding-block: var(--space-sm);
    gap: var(--space-md);
  }

  .header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    line-height: 0;
    text-decoration: none;
    color: inherit;
  }

  .header__logo {
    display: block;
    width: auto;
    height: auto;
    max-height: var(--header-logo-max);
    margin-inline-start: calc(-1 * var(--content-inset-start));
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 768px) {
    .header__logo {
      max-height: 3.5rem;
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  .header__toggle {
    display: flex;
    min-height: var(--touch-min);
    padding: 0 var(--space-md);
    font: inherit;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
  }

  .header__nav {
    display: none;
  }

  .header__nav.is-open {
    display: block;
    position: absolute;
    left: calc(-1 * var(--layout-inline-padding));
    right: calc(-1 * var(--layout-inline-padding));
    width: calc(100% + 2 * var(--layout-inline-padding));
    top: var(--header-height);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) var(--layout-inline-padding);
  }

  .header__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .header__link {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: 0;
    text-decoration: none;
    font-weight: 500;
    color: var(--color-text);
    border-radius: var(--radius-sm);
  }

  .header__link:hover {
    color: var(--color-primary);
    background: var(--color-bg);
  }

  .header__link.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .header__toggle {
      display: none;
    }

    .header__nav {
      display: block;
      position: static;
      padding: 0;
      border: none;
      flex: 1;
    }

    .header__list {
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-md);
      padding-inline-end: var(--space-sm);
    }

    .header__actions {
      margin-inline-start: 0;
    }
  }
</style>
