---
import { siteConfig, isNavHrefActive } from '@/config/site.config';
import { CartNavLink } from '../cart/CartNavLink';

const path = Astro.url.pathname;

function isGroupActive(links: readonly { href: string }[]): boolean {
  return links.some((link) => isNavHrefActive(link.href, path));
}
---

<header class="header header--overlay layout-bleed">
  <div class="site-rail site-rail--header header__inner">
    <a class="header__brand" href="/" aria-label={`${siteConfig.shortName} — home`}>
      <img
        class="header__logo"
        src="/logo.png"
        alt=""
        width="1190"
        height="1190"
        decoding="async"
        fetchpriority="high"
      />
    </a>
    <nav class="header__nav" id="site-nav" aria-label="Principale">
      <ul class="header__list">
        {
          siteConfig.nav.map((item) => {
            if (item.kind === 'link') {
              const active = isNavHrefActive(item.href, path);
              return (
                <li class="header__item">
                  <a
                    href={item.href}
                    class:list={['header__link', { 'is-active': active }]}
                    aria-current={active ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              );
            }

            const groupActive = isGroupActive(item.links);
            return (
              <li
                class:list={['header__item', 'header__item--disclosure', { 'is-active': groupActive }]}
                data-nav-disclosure
              >
                <button
                  type="button"
                  class="header__link header__menu-trigger"
                  aria-expanded="false"
                  aria-controls={item.menuId}
                  data-nav-disclosure-trigger
                >
                  {item.label}
                  <span class="header__menu-chevron" aria-hidden="true" />
                </button>
                <ul id={item.menuId} class="header__submenu" data-nav-disclosure-panel>
                  {item.links.map((link) => {
                    const active = isNavHrefActive(link.href, path);
                    return (
                      <li>
                        <a
                          href={link.href}
                          class:list={['header__sublink', { 'is-active': active }]}
                          aria-current={active ? 'page' : undefined}
                        >
                          {link.label}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </li>
            );
          })
        }
      </ul>
    </nav>
    <div class="header__actions">
      <CartNavLink client:load />
      <button
        type="button"
        class="header__toggle"
        aria-expanded="false"
        aria-controls="site-nav"
        id="nav-toggle"
      >
        Menu
      </button>
    </div>
  </div>
</header>

<script>
  import { initHeaderScroll } from '@/scripts/headerScroll';
  import { initHeaderNavMenu } from '@/scripts/headerNavMenu';

  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    initHeaderScroll();
  });

  function initHeader() {
    initHeaderScroll();
    initHeaderNavMenu();
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    transition:
      background-color 0.28s ease,
      border-color 0.28s ease,
      box-shadow 0.28s ease;
  }

  .header.header--overlay:not(.header--solid) {
    background: transparent;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  .header.header--solid {
    background: var(--color-surface);
    border-bottom-color: var(--color-border);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.04);
  }

  .header.header--overlay:not(.header--solid) .header__link,
  .header.header--overlay:not(.header--solid) .header__menu-trigger {
    color: #fff;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.45);
  }

  .header.header--overlay:not(.header--solid) .header__link:hover,
  .header.header--overlay:not(.header--solid) .header__menu-trigger:hover {
    color: #fff;
    background: rgb(255 255 255 / 0.12);
  }

  .header.header--overlay:not(.header--solid) .header__link.is-active,
  .header.header--overlay:not(.header--solid) .header__item--disclosure.is-active .header__menu-trigger {
    color: #fff;
    font-weight: 600;
  }

  .header.header--overlay:not(.header--solid) .header__toggle {
    color: #fff;
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.55);
  }

  .header__inner {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--header-height);
    padding-block: var(--space-sm);
    gap: var(--space-md);
  }

  .header__brand {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    line-height: 0;
    text-decoration: none;
    color: inherit;
  }

  .header__logo {
    display: block;
    width: auto;
    height: auto;
    max-height: var(--header-logo-max);
    margin-inline-start: calc(-1 * var(--content-inset-start));
    object-fit: contain;
    object-position: left center;
  }

  @media (min-width: 768px) {
    .header__logo {
      max-height: 3.5rem;
    }
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-inline-start: auto;
    flex-shrink: 0;
  }

  .header__toggle {
    display: flex;
    min-height: var(--touch-min);
    padding: 0 var(--space-md);
    font: inherit;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    cursor: pointer;
  }

  .header__nav {
    display: none;
  }

  .header__nav.is-open {
    display: block;
    position: absolute;
    left: calc(-1 * var(--layout-inline-padding));
    right: calc(-1 * var(--layout-inline-padding));
    width: calc(100% + 2 * var(--layout-inline-padding));
    top: var(--header-height);
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-md) var(--layout-inline-padding);
  }

  .header__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .header__item {
    margin: 0;
    padding: 0;
  }

  .header__link,
  .header__menu-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    min-height: var(--touch-min);
    padding: 0;
    text-decoration: none;
    font: inherit;
    font-weight: 500;
    color: var(--color-text);
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    cursor: pointer;
    text-align: start;
  }

  .header__link:hover,
  .header__menu-trigger:hover {
    color: var(--color-primary);
    background: var(--color-bg);
  }

  .header__link.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .header__menu-chevron {
    width: 0.5rem;
    height: 0.5rem;
    margin-inline-start: auto;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    translate: 0 -0.15rem;
    opacity: 0.75;
  }

  .header__submenu {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .header__sublink {
    display: flex;
    align-items: center;
    min-height: var(--touch-min);
    padding: 0;
    text-decoration: none;
    font-weight: 500;
    color: var(--color-text-muted, var(--color-text));
    border-radius: var(--radius-sm);
  }

  .header__sublink:hover {
    color: var(--color-primary);
    background: var(--color-bg);
  }

  .header__sublink.is-active {
    color: var(--color-primary);
    font-weight: 600;
  }

  .header__item--disclosure.is-active .header__menu-trigger {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .header__toggle {
      display: none;
    }

    .header__nav {
      display: block;
      position: static;
      padding: 0;
      border: none;
      flex: 1;
    }

    .header__list {
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-md);
      padding-inline-end: var(--space-sm);
    }

    .header__actions {
      margin-inline-start: 0;
    }

    .header__link,
    .header__menu-trigger {
      width: auto;
    }

    .header__menu-chevron {
      margin-inline-start: 0.15rem;
      translate: 0 -0.1rem;
    }

    .header__item--disclosure {
      position: relative;
    }

    .header__submenu {
      position: absolute;
      top: calc(100% + var(--space-xs));
      right: 0;
      z-index: 110;
      min-width: 13.5rem;
      padding: var(--space-sm);
      gap: var(--space-xs);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.08);
      display: none;
    }

    .header__item--disclosure.is-open .header__submenu,
    .header__item--disclosure:focus-within .header__submenu,
    .header__item--disclosure:hover .header__submenu {
      display: flex;
    }

    .header__sublink {
      padding: 0 var(--space-sm);
      min-height: 2.5rem;
    }
  }
</style>
