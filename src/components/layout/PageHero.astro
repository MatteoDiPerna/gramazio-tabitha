---
interface Props {
  title: string;
  lead: string;
  imageSrc?: string;
  /** `home` = viewport; `page` = banner foto; `compact` = intestazione senza foto (pagine strumento) */
  size?: 'home' | 'page' | 'compact';
  /** Priorità LCP (solo homepage) */
  priority?: boolean;
}

const { title, lead, imageSrc = '', size = 'page', priority = false } = Astro.props;
const isPhoto = size !== 'compact' && Boolean(imageSrc);

const hasActions = Astro.slots.has('actions');
---

<section
  class:list={[
    'page-hero',
    'layout-bleed',
    { 'page-hero--photo': isPhoto, 'page-hero--home': size === 'home', 'page-hero--compact': size === 'compact' },
  ]}
  aria-labelledby="page-hero-title"
>
  {
    isPhoto && (
      <>
        <img
          class="page-hero__photo"
          src={imageSrc}
          alt=""
          width="1920"
          height="640"
          fetchpriority={priority ? 'high' : undefined}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
          aria-hidden="true"
        />
        <div class="page-hero__scrim" aria-hidden="true" />
      </>
    )
  }
  <div class="container page-hero__inner">
    <h1 id="page-hero-title" class="page-hero__title">{title}</h1>
    <p class="page-hero__lead">{lead}</p>
    {
      hasActions && (
        <div class="page-hero__actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: clamp(12rem, 28vh, 18rem);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: calc(var(--header-height) + var(--space-xl)) 0 var(--space-xl);
    margin-bottom: var(--space-2xl);
    border-bottom: none;
    background: #1a1f18;
  }

  .page-hero--home {
    /* Homepage: viewport intera (header fisso trasparente sopra l’immagine) */
    min-height: clamp(12rem, 28vh, 18rem);
    min-height: 100svh;
    min-height: 100dvh;
    padding: calc(var(--header-height) + var(--space-2xl)) 0 var(--space-2xl);
    margin-bottom: var(--space-2xl);
  }

  .page-hero__photo {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center center;
    filter: brightness(0.82);
  }

  .page-hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 85% 75% at 50% 48%, rgb(0 0 0 / 0.62) 0%, rgb(0 0 0 / 0.28) 55%, rgb(0 0 0 / 0.45) 100%),
      linear-gradient(to bottom, rgb(12 14 10 / 0.55), rgb(12 14 10 / 0.72));
  }

  .page-hero__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .page-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.08;
    color: #fff;
    text-shadow:
      0 2px 4px rgb(0 0 0 / 0.55),
      0 4px 24px rgb(0 0 0 / 0.45);
    margin: 0 0 var(--space-md);
    max-width: 22ch;
    text-wrap: balance;
  }

  .page-hero--home .page-hero__title {
    max-width: 18ch;
  }

  .page-hero__lead {
    margin: 0;
    max-width: 34rem;
    font-family: var(--font-body);
    font-size: clamp(var(--text-sm), 1.8vw, var(--text-base));
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.55;
    text-transform: none;
    color: #fff;
    text-shadow:
      0 1px 3px rgb(0 0 0 / 0.6),
      0 2px 16px rgb(0 0 0 / 0.4);
    text-wrap: balance;
  }

  .page-hero--home .page-hero__lead {
    max-width: 28rem;
    letter-spacing: 0.1em;
  }

  .page-hero--compact {
    min-height: auto;
    margin-bottom: var(--space-xl);
    padding: calc(var(--header-height) + var(--space-lg)) 0 var(--space-lg);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-sm);
  }

  .page-hero--compact .page-hero__title {
    color: var(--color-primary);
    text-shadow: none;
    font-style: normal;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    max-width: none;
  }

  .page-hero--compact .page-hero__lead {
    color: var(--color-text-muted);
    text-shadow: none;
    letter-spacing: 0.06em;
    font-size: 0.8125rem;
  }

  .page-hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .page-hero--photo :global(.page-hero__btn-secondary) {
    background: rgb(255 255 255 / 0.1);
    border-color: rgb(255 255 255 / 0.85);
    color: #fff;
  }

  .page-hero--photo :global(.page-hero__btn-secondary:hover) {
    background: #fff;
    color: var(--color-primary);
    border-color: #fff;
  }
</style>
