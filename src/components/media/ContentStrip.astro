---
interface Props {
  src: string;
  alt: string;
  /** Altezza visiva consigliata per bande orizzontali (responsive). */
  height?: 'sm' | 'md' | 'lg';
}

const { src, alt, height = 'md' } = Astro.props;
---

<figure class:list={['content-strip', `content-strip--${height}`]}>
  <img src={src} alt={alt} loading="lazy" decoding="async" />
</figure>

<style>
  .content-strip {
    margin: 0 0 var(--space-xl);
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .content-strip img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .content-strip--sm {
    aspect-ratio: 21 / 5;
  }

  .content-strip--md {
    aspect-ratio: 21 / 7;
  }

  .content-strip--lg {
    aspect-ratio: 16 / 5;
  }

  @media (max-width: 767px) {
    .content-strip--sm,
    .content-strip--md,
    .content-strip--lg {
      aspect-ratio: 16 / 9;
    }
  }
</style>
