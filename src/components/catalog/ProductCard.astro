---
import type { Product } from '@/domain/catalog/catalog.schema';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import { AddToCartButton } from '../cart/AddToCartButton';
import { canAddProductToCart } from '@/domain/cart/logic';
import {
  formatVariantPrice,
  pricePerLiter,
  productAvailabilityLabel,
} from '@/domain/catalog/display';
import { resolveProductImageSrc } from '@/domain/catalog/productImage';
import { productSpinFrameUrls } from '@/domain/catalog/productSpin';
import { ProductSpinViewer } from './ProductSpinViewer';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const imageSrc = resolveProductImageSrc(product);
const spinFrames = productSpinFrameUrls(product.slug);
const variant = product.variants[0];
const perLiter = pricePerLiter(variant);
const canAdd = canAddProductToCart(product);
---

<Card as="article" class="product-card">
  <div class="product-card__media">
    <ProductSpinViewer
      client:visible
      slug={product.slug}
      alt={product.image.alt}
      fallbackSrc={imageSrc}
      frameUrls={spinFrames}
      productHref={`/prodotti/${product.slug}`}
      showMediaControls
      className="product-card__spin"
    />
  </div>
  <div class="product-card__body">
    <div class="product-card__content">
      <div class="product-card__badges">
        {product.badges?.includes('bio') && <Badge variant="bio">Bio</Badge>}
        {product.badges?.includes('slow-food') && <Badge variant="slow-food">Slow Food</Badge>}
      </div>
      <h2 class="product-card__title">
        <a href={`/prodotti/${product.slug}`}>{product.name}</a>
      </h2>
      <p class="product-card__desc">{product.shortDescription}</p>
      <div class="product-card__meta-block">
        <p class="product-card__format">{variant.label}</p>
        <p class="product-card__price">
          <strong>{formatVariantPrice(variant)}</strong>
          {perLiter && <span class="product-card__liter"> ({perLiter})</span>}
        </p>
        <p class="product-card__avail">{productAvailabilityLabel(product)}</p>
      </div>
    </div>
    <div class="product-card__actions">
      <div class="product-card__purchase">
        <AddToCartButton
          client:load
          productId={product.id}
          variantId={variant.id}
          canAdd={canAdd}
          compact
        />
      </div>
      <Button
        href={`/prodotti/${product.slug}`}
        variant="secondary"
        class="product-card__cta"
      >
        Dettagli
      </Button>
    </div>
  </div>
</Card>

<style>
  .product-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    container-type: inline-size;
  }

  .product-card__media {
    display: block;
    width: 100%;
    height: clamp(12.75rem, 24vw, 13.5rem);
    flex-shrink: 0;
    overflow: hidden;
    background: var(--color-product-shot-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .product-card__media :global(.product-card__spin) {
    width: 100%;
    height: 100%;
    background: var(--color-product-shot-bg);
  }

  .product-card__media :global(.product-card__spin .product-spin__viewport) {
    width: 100%;
    height: 100%;
    background: var(--color-product-shot-bg);
  }

  .product-card__media :global(.product-card__spin .product-spin__frame) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    padding: 0.35rem 0.5rem;
    box-sizing: border-box;
  }

  .product-card__media :global(.product-spin__control) {
    min-width: 1.65rem;
    height: 1.65rem;
    font-size: 0.9375rem;
  }

  .product-card__body {
    padding: var(--space-lg) var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    gap: 0;
  }

  .product-card__content {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-height: 0;
  }

  .product-card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-xs);
    min-height: 1.375rem;
  }

  .product-card__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin: 0;
    line-height: 1.2;
    min-height: calc(2 * 1.2 * 1.125rem);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .product-card__title a {
    display: block;
    text-decoration: none;
    color: var(--color-primary);
  }

  .product-card__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    min-height: calc(2 * 1.45 * 0.875rem);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .product-card__meta-block {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .product-card__format,
  .product-card__price {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .product-card__format {
    color: var(--color-text-muted);
  }

  .product-card__price strong {
    font-weight: 600;
    color: var(--color-text);
  }

  .product-card__liter {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .product-card__avail {
    margin: 0.1rem 0 0;
    font-size: 0.75rem;
    line-height: 1.35;
    color: var(--color-accent-warm);
  }

  .product-card__actions {
    flex: 0 0 auto;
    margin-top: var(--space-md);
    padding-top: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    width: 100%;
  }

  .product-card__purchase {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .product-card__purchase :global(.add-cart--compact) {
    width: 100%;
  }

  .product-card__cta:global(.btn) {
    width: 100%;
    box-sizing: border-box;
    margin-top: 0;
    min-height: 2.5rem;
    padding-block: 0;
    font-size: 0.9375rem;
  }
</style>
