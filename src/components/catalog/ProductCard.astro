---
import type { Product } from '@/domain/catalog/catalog.schema';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Card from '../ui/Card.astro';
import { AddToCartButton } from '../cart/AddToCartButton';
import { canAddProductToCart } from '@/domain/cart/logic';
import {
  formatVariantPrice,
  pricePerLiter,
  productAvailabilityLabel,
} from '@/domain/catalog/display';
import { resolveProductImageSrc } from '@/domain/catalog/productImage';
import { productSpinFrameUrls } from '@/domain/catalog/productSpin';
import { ProductSpinViewer } from './ProductSpinViewer';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const imageSrc = resolveProductImageSrc(product);
const spinFrames = productSpinFrameUrls(product.slug);
const variant = product.variants[0];
const perLiter = pricePerLiter(variant);
const canAdd = canAddProductToCart(product);
---

<Card as="article" class="product-card">
  <div class="product-card__media">
    <ProductSpinViewer
      client:visible
      slug={product.slug}
      alt={product.image.alt}
      fallbackSrc={imageSrc}
      frameUrls={spinFrames}
      productHref={`/prodotti/${product.slug}`}
      showMediaControls
      className="product-card__spin"
    />
  </div>
  <div class="product-card__body">
    <div class="product-card__badges">
      {product.badges?.includes('bio') && <Badge variant="bio">Bio</Badge>}
      {product.badges?.includes('slow-food') && <Badge variant="slow-food">Slow Food</Badge>}
    </div>
    <h2 class="product-card__title">
      <a href={`/prodotti/${product.slug}`}>{product.name}</a>
    </h2>
    <p class="product-card__desc">{product.shortDescription}</p>
    <div class="product-card__meta-block">
      <p class="product-card__meta">
        <span>{variant.label}</span>
        ·
        <strong>{formatVariantPrice(variant)}</strong>
        {perLiter && <span class="product-card__liter"> ({perLiter})</span>}
      </p>
      <p class="product-card__avail">{productAvailabilityLabel(product)}</p>
    </div>
    <div class="product-card__actions">
      <AddToCartButton
        client:load
        productId={product.id}
        variantId={variant.id}
        canAdd={canAdd}
        compact
      />
      <Button
        href={`/prodotti/${product.slug}`}
        variant="ghost"
        class="product-card__cta"
      >
        Dettagli
      </Button>
    </div>
  </div>
</Card>

<style>
  .product-card {
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    container-type: inline-size;
  }

  .product-card__media {
    display: block;
    width: 100%;
    height: clamp(12.75rem, 24vw, 13.5rem);
    flex-shrink: 0;
    overflow: hidden;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .product-card__media :global(.product-card__spin) {
    width: 100%;
    height: 100%;
  }

  .product-card__media :global(.product-card__spin .product-spin__viewport) {
    width: 100%;
    height: 100%;
  }

  .product-card__media :global(.product-card__spin .product-spin__frame) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center center;
    padding: 0.35rem 0.5rem;
    box-sizing: border-box;
  }

  .product-card__media :global(.product-spin__control) {
    min-width: 1.65rem;
    height: 1.65rem;
    font-size: 0.9375rem;
  }

  .product-card__body {
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: var(--space-xs);
  }

  .product-card__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-xs);
  }

  .product-card__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin: 0;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .product-card__title a {
    display: block;
    text-decoration: none;
    color: var(--color-primary);
  }

  .product-card__desc {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .product-card__meta {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .product-card__liter {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .product-card__avail {
    margin: 0.15rem 0 0;
    font-size: 0.75rem;
    color: var(--color-accent-warm);
  }

  .product-card__actions {
    margin-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .product-card__cta:global(.btn) {
    width: 100%;
    margin-top: 0;
    min-height: 2.5rem;
    padding-block: 0;
    font-size: 0.9375rem;
  }
</style>
