---
import SectionHead from '@/components/ui/SectionHead.astro';
import type { CatalogCategoryId } from '@/domain/catalog/catalogCategories';
import { catalogPageIntro } from '@/content/catalogPage';

interface Props {
  activeCategory: CatalogCategoryId | null;
}

const { activeCategory } = Astro.props;

const intro = activeCategory
  ? catalogPageIntro.byCategory[activeCategory]
  : catalogPageIntro.all;
---

<div class="catalog-intro" data-catalog-intro>
  {
    activeCategory ? (
      <p class="catalog-intro__body">{intro.body}</p>
    ) : (
      <SectionHead
        centered
        eyebrow="Catalogo"
        title={intro.title}
        lead={intro.body}
      />
    )
  }
</div>

<style>
  .catalog-intro {
    margin-top: var(--space-xl);
    width: 100%;
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .catalog-intro__body {
    margin: 0;
    line-height: 1.65;
    color: var(--color-text-muted);
    text-align: left;
  }

  @media (min-width: 768px) {
    .catalog-intro__body {
      text-align: center;
    }
  }
</style>
