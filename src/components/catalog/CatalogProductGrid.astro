---
import type { Product } from '@/domain/catalog/catalog.schema';
import ProductCard from '@/components/catalog/ProductCard.astro';

interface Props {
  products: Product[];
}

const { products } = Astro.props;
---

<ul class="product-grid catalog-grid" data-catalog-grid>
  {
    products.map((product) => {
      const pricingIncomplete = product.variants.every((v) => v.priceCents == null);
      return (
        <li
          data-catalog-product
          data-catalog-category={product.category}
          data-catalog-name={product.name}
          data-catalog-search={`${product.name} ${product.shortDescription}`}
          data-catalog-pricing-incomplete={pricingIncomplete ? 'true' : 'false'}
        >
          <ProductCard product={product} />
        </li>
      );
    })
  }
</ul>

<style>
  .catalog-grid {
    margin-top: var(--space-xl);
  }
</style>
