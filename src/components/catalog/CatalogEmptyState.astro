---
interface Props {
  kind: 'category' | 'pricing';
}

const { kind } = Astro.props;

const message =
  kind === 'category'
    ? 'Nessun prodotto in questa categoria al momento.'
    : 'Il listino è in aggiornamento: alcuni prezzi compariranno come «Prezzo su richiesta» finché non saranno confermati.';
---

<div class:list={['catalog-empty', { 'catalog-empty--info': kind === 'pricing' }]} role="status">
  <p>{message}</p>
  <a href="/catalogo">Vedi tutti i prodotti</a>
</div>

<style>
  .catalog-empty {
    margin-top: var(--space-xl);
    padding: var(--space-xl);
    text-align: center;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .catalog-empty p {
    margin: 0 0 var(--space-md);
    color: var(--color-text-muted);
  }

  .catalog-empty a {
    font-weight: 600;
    color: var(--color-primary);
  }

  .catalog-empty--info {
    text-align: left;
    border-style: solid;
    background: #fff8e6;
    margin-top: var(--space-lg);
    padding: var(--space-md) var(--space-lg);
  }

  .catalog-empty--info a {
    display: none;
  }
</style>
