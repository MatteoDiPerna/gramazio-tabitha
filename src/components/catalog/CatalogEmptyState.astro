---
import Button from '@/components/ui/Button.astro';

interface Props {
  kind: 'category' | 'pricing';
}

const { kind } = Astro.props;

const isCategory = kind === 'category';
---

<div class="catalog-empty" role="status">
  <p class="catalog-empty__text">
    {
      isCategory
        ? 'Nessun prodotto in questa categoria al momento.'
        : 'Il listino è in aggiornamento: alcuni prezzi compariranno come «Prezzo su richiesta» finché non saranno confermati.'
    }
  </p>
  {isCategory && <Button href="/catalogo">Vedi tutti i prodotti</Button>}
</div>

<style>
  .catalog-empty {
    margin-top: var(--space-xl);
    padding: var(--space-xl);
    text-align: center;
    background: var(--color-surface);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    max-width: 28rem;
    margin-inline: auto;
  }

  .catalog-empty__text {
    margin: 0 0 var(--space-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>
