---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Button from '@/components/ui/Button.astro';
import ProductCard from '@/components/catalog/ProductCard.astro';
import { siteConfig } from '@/config/site.config';
import { homeMedia } from '@/config/home.media';
import { getPublishedProducts } from '@/domain/catalog';
import { buildWhatsAppUrl } from '@/domain/order/whatsapp';
import {
  homeAbout,
  homeBannerDivider,
  homeGallerySection,
  homeOilFactsSection,
  homeQuoteDivider,
  homeReviewsSection,
  homeServicesSection,
} from '@/content/homePage';

const products = getPublishedProducts().slice(0, 3);

const heroBannerImage = '/images/home/hero-banner.png';
const aboutPhoto = homeMedia.aboutPhoto;
const bannerDividerImage = homeMedia.bannerDivider;

const waIntro = `Buongiorno, vorrei informazioni sui prodotti de ${siteConfig.name}.`;
const waHref = buildWhatsAppUrl(waIntro);
---

<BaseLayout>
  <PageHero
    size="home"
    priority
    title={siteConfig.name}
    lead="Olio extravergine biologico e prodotti del Gargano"
    imageSrc={heroBannerImage}
  >
    <Button slot="actions" href="/catalogo" variant="primary" size="lg">Scopri i prodotti</Button>
    <Button slot="actions" href="/contatti" variant="secondary" size="lg" class="page-hero__btn-secondary">
      Contattaci
    </Button>
  </PageHero>

  <section class="home-about section home-viewport-panel" aria-labelledby="home-about-title">
    <div class="container home-about__grid">
      <div class="home-about__visual">
        <div class="home-about__decor" aria-hidden="true">
          <span class="home-about__ring home-about__ring--outer" />
          <span class="home-about__ring home-about__ring--accent" />
        </div>
        <figure class="home-about__figure">
          <img
            class="home-about__photo"
            src={aboutPhoto}
            alt="Olive su ulivo nel Gargano"
            width="1200"
            height="675"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
      <div class="home-about__copy">
        <p class="home-eyebrow">{homeAbout.eyebrow}</p>
        <h2 id="home-about-title" class="home-display-title">{homeAbout.title}</h2>
        <p class="home-ornament" aria-hidden="true" />
        {
          homeAbout.paragraphs.map((paragraph) => (
            <p class="home-about__para">{paragraph}</p>
          ))
        }
        <ul class="home-about__highlights">
          {
            homeAbout.highlights.map((item) => (
              <li>
                <span class="home-about__highlight-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 3c-4 3-7 6-7 10a7 7 0 0 0 14 0c0-4-3-7-7-10z" />
                    <path d="M12 12v5" />
                  </svg>
                </span>
                <span>
                  <strong>{item.title}</strong>
                  <span class="home-about__highlight-text">{item.text}</span>
                </span>
              </li>
            ))
          }
        </ul>
        <div class="home-about__actions">
          <Button href="/chi-siamo" variant="primary" class="home-btn-accent">
            Continua a leggere
          </Button>
          {
            waHref ? (
              <Button href={waHref} variant="whatsapp" class="home-btn-accent-outline">
                Contattaci su WhatsApp
              </Button>
            ) : (
              <Button href={`tel:${siteConfig.phoneTel}`} variant="secondary">
                Chiamaci
              </Button>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <section class="home-divider layout-bleed home-snap-target" aria-label={homeBannerDivider.title}>
    <div class="home-divider__bg" aria-hidden="true">
      <img
        src={bannerDividerImage}
        alt=""
        width="1920"
        height="480"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="home-divider__scrim" aria-hidden="true" />
    <div class="home-divider__content">
      <span class="home-divider__badge" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M12 3c-4 3-7 6-7 10a7 7 0 0 0 14 0c0-4-3-7-7-10z" />
        </svg>
      </span>
      <h2 class="home-divider__title">{homeBannerDivider.title}</h2>
    </div>
  </section>

  <section class="home-services section section--alt" aria-labelledby="home-services-title">
    <div class="container">
      <header class="home-section-head home-section-head--center">
        <p class="home-eyebrow">{homeServicesSection.eyebrow}</p>
        <h2 id="home-services-title" class="home-display-title">{homeServicesSection.title}</h2>
        <p class="home-ornament home-ornament--center" aria-hidden="true" />
      </header>
      <ul class="home-services__grid">
        {
          homeServicesSection.items.map((service) => (
            <li>
              <article class="home-service-card">
                <span class="home-service-card__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="9" cy="20" r="1" />
                    <circle cx="17" cy="20" r="1" />
                    <path d="M2 4h2l2.5 12h11L21 8H6" />
                  </svg>
                </span>
                <h3 class="home-service-card__title">{service.title}</h3>
                <p class="home-service-card__text">{service.description}</p>
                <a class="home-service-card__link" href={service.href} aria-label={`Scopri: ${service.title}`}>
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="home-gallery section" aria-labelledby="home-gallery-title">
    <div class="container">
      <header class="home-section-head home-section-head--center">
        <p class="home-eyebrow">{homeGallerySection.eyebrow}</p>
        <h2 id="home-gallery-title" class="home-display-title">{homeGallerySection.title}</h2>
        <p class="home-ornament home-ornament--center" aria-hidden="true" />
      </header>
    </div>
    <div class="home-gallery__bleed layout-bleed">
      <div
        class="home-gallery__track"
        data-home-gallery
        tabindex="0"
        role="region"
        aria-label="Galleria fotografica — trascina per scorrere"
      >
        <ul class="home-gallery__list">
          {
            homeGallerySection.slides.map((slide) => (
              <li>
                <figure class="home-gallery__slide">
                  <img
                    src={slide.src}
                    alt={slide.alt}
                    width="320"
                    height="427"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption class="home-gallery__caption">{slide.caption}</figcaption>
                </figure>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="home-oil-facts section section--alt" aria-labelledby="home-oil-title">
    <div class="container">
      <header class="home-section-head home-section-head--center">
        <p class="home-eyebrow">{homeOilFactsSection.eyebrow}</p>
        <h2 id="home-oil-title" class="home-display-title">{homeOilFactsSection.title}</h2>
        <p class="home-ornament home-ornament--center" aria-hidden="true" />
      </header>
      <ol class="home-oil-facts__steps">
        {
          homeOilFactsSection.steps.map((step, index) => (
            <li class="home-oil-step">
              {index < homeOilFactsSection.steps.length - 1 && (
                <span class="home-oil-step__arrow" aria-hidden="true" />
              )}
              <div class="home-oil-step__icon-wrap">
                <span class="home-oil-step__num">{step.num}</span>
                <span class="home-oil-step__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" />
                  </svg>
                </span>
              </div>
              <h3 class="home-oil-step__title">{step.title}</h3>
              <p class="home-oil-step__body" set:html={step.bodyHtml} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="home-quote layout-bleed" aria-label="Citazione">
    <div class="home-quote__pattern" aria-hidden="true" />
    <blockquote class="home-quote__inner">
      <p class="home-quote__text">{homeQuoteDivider.quote}</p>
      <footer class="home-quote__attr">{homeQuoteDivider.attribution}</footer>
    </blockquote>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">In evidenza</h2>
        <a href="/catalogo">Vedi tutti i prodotti</a>
      </div>
      <ul class="product-grid">
        {
          products.map((product) => (
            <li>
              <ProductCard product={product} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band">
      <h2 class="section__title">Ordina in modo semplice</h2>
      <p class="lead">
        Sfoglia il catalogo, prepara il tuo ordine e inviaci la richiesta via telefono o email.
        Nessuna registrazione: ti ricontattiamo per disponibilità, spedizione e pagamento.
      </p>
      <Button href="/catalogo" variant="primary">Vai al catalogo</Button>
    </div>
  </section>

  <section class="home-reviews section section--alt" aria-labelledby="home-reviews-title">
    <div class="container">
      <header class="home-section-head home-section-head--center">
        <p class="home-eyebrow">{homeReviewsSection.eyebrow}</p>
        <h2 id="home-reviews-title" class="home-display-title">{homeReviewsSection.title}</h2>
        <p class="home-ornament home-ornament--center" aria-hidden="true" />
      </header>
      <ul class="home-reviews__grid">
        {
          homeReviewsSection.items.map((review) => (
            <li>
              <article class="home-review-card">
                <div class="home-review-card__stars" aria-label={`${review.rating} su 5 stelle`}>
                  {
                    Array.from({ length: review.rating }, () => (
                      <span aria-hidden="true">★</span>
                    ))
                  }
                </div>
                <p class="home-review-card__text">«{review.text}»</p>
                <footer class="home-review-card__meta">
                  <strong>{review.name}</strong>
                  <span>{review.place}</span>
                </footer>
              </article>
            </li>
          ))
        }
      </ul>
      <p class="home-reviews__disclaimer">{homeReviewsSection.disclaimer}</p>
    </div>
  </section>
</BaseLayout>

<script>
  import { initAllHomeGalleries } from '@/scripts/homeGallery';

  const HOME_SNAP_CLASS = 'home-scroll-snap';

  function setHomeScrollSnap(enabled: boolean) {
    document.documentElement.classList.toggle(HOME_SNAP_CLASS, enabled);
  }

  function initHomePageScroll() {
    setHomeScrollSnap(Boolean(document.querySelector('.home-viewport-panel')));
  }

  initAllHomeGalleries();
  initHomePageScroll();

  document.addEventListener('astro:before-swap', () => setHomeScrollSnap(false));
  document.addEventListener('astro:page-load', () => {
    initAllHomeGalleries();
    initHomePageScroll();
  });
</script>
