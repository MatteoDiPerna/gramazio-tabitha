---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/ui/Button.astro';
import ProductCard from '@/components/catalog/ProductCard.astro';
import ContentStrip from '@/components/media/ContentStrip.astro';
import { siteConfig } from '@/config/site.config';
import { homeMedia } from '@/config/home.media';
import { getPublishedProducts } from '@/domain/catalog';

const products = getPublishedProducts().slice(0, 3);
---

<BaseLayout>
  {
    homeMedia.heroBanner && (
      <div class="hero-banner">
        <img
          src={homeMedia.heroBanner}
          alt="Panorama dell'azienda agricola e del territorio del Gargano"
          width="1920"
          height="640"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    )
  }
  <section class="hero">
    <div class="container hero__inner">
      <p class="hero__eyebrow">Carpino · Gargano · FG</p>
      <h1 class="hero__title">{siteConfig.name}</h1>
      <p class="hero__lead">
        Olio extravergine biologico e prodotti agricoli del territorio, con cura per la
        stagionalità e le cultivar autoctone.
      </p>
      <div class="hero__actions">
        <Button href="/catalogo" variant="primary" size="lg">Scopri i prodotti</Button>
        <Button href="/contatti" variant="secondary" size="lg">Contattaci</Button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {
        homeMedia.stripChiSiamo && (
          <ContentStrip
            src={homeMedia.stripChiSiamo}
            alt="Immagine della produzione agricola e del territorio di Carpino"
            height="md"
          />
        )
      }
      <h2 class="section__title">Chi siamo</h2>
      <p class="lead">
        Produzione agricola artigianale a Carpino: olio EVO biologico e specialità locali come
        la fava di Carpino. Valorizziamo il legame con il territorio del Gargano e il rispetto
        dei cicli naturali.
      </p>
      <p>
        <a href="/chi-siamo">Leggi la nostra storia →</a>
      </p>
    </div>
  </section>

  {
    homeMedia.stripTerritorio && (
      <section class="section section--flush" aria-label="Il territorio">
        <div class="container">
          <ContentStrip
            src={homeMedia.stripTerritorio}
            alt="Paesaggio e cultivar del Gargano"
            height="lg"
          />
        </div>
      </section>
    )
  }

  <section class="section section--alt">
    <div class="container">
      <div class="section__head">
        <h2 class="section__title">In evidenza</h2>
        <a href="/catalogo">Vedi tutti i prodotti</a>
      </div>
      <ul class="product-grid">
        {
          products.map((product) => (
            <li>
              <ProductCard product={product} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container cta-band">
      <h2 class="section__title">Ordina in modo semplice</h2>
      <p class="lead">
        Sfoglia il catalogo, prepara il tuo ordine e inviaci la richiesta via telefono o email.
        Nessuna registrazione: ti ricontattiamo per disponibilità, spedizione e pagamento.
      </p>
      <Button href="/catalogo" variant="primary">Vai al catalogo</Button>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-banner {
    width: 100%;
    max-height: min(42vh, 28rem);
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .hero-banner img {
    width: 100%;
    height: 100%;
    min-height: 12rem;
    object-fit: cover;
    display: block;
  }

  .hero {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-2xl) 0;
  }

  .hero__eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-accent-warm);
    margin: 0 0 var(--space-sm);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    line-height: 1.1;
    color: var(--color-primary);
    margin: 0 0 var(--space-md);
    max-width: 22ch;
  }

  .hero__lead {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 52rem;
    margin: 0 0 var(--space-xl);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
  }

  .section {
    padding: var(--space-2xl) 0;
  }

  .section--flush {
    padding-top: 0;
    padding-bottom: var(--space-xl);
  }

  .section--alt {
    background: var(--color-surface);
    border-block: 1px solid var(--color-border);
  }

  .section__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .section__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    color: var(--color-primary);
    margin: 0;
  }

  .cta-band {
    text-align: center;
  }

  .cta-band .lead {
    margin-inline: auto;
    margin-bottom: var(--space-lg);
  }
</style>
