---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { staticPageHeroes } from '@/content/pageHeroes';

const hero = staticPageHeroes.privacy;
---

<BaseLayout title="Privacy" description="Informativa sul trattamento dei dati personali.">
  <PageHero
    title={hero.title}
    lead={hero.lead}
    imageSrc={hero.image}
  />
  <PageContainer prose>
    <p class="legal-notice">
      <strong>Bozza tecnica.</strong> Testo da sostituire con informativa redatta dal titolare
      del trattamento e/o professionista qualificato (GDPR).
    </p>
    <p>
      Attraverso questo sito potrai contattare l'Azienda Agricola Gramazio Tabitha e, in futuro,
      inviare richieste d'ordine. I dati che inserisci volontariamente (nome, telefono, note)
      saranno trattati per gestire la richiesta commerciale.
    </p>
    <p>
      Per esercitare i diritti previsti dal Regolamento UE 2016/679 o per chiarimenti, usa i
      contatti nella pagina <a href="/contatti">Contatti</a>.
    </p>
  </PageContainer>
</BaseLayout>

<style>
  .legal-notice {
    padding: var(--space-md);
    background: #fff8e6;
    border: 1px solid #e8dcc4;
    border-radius: var(--radius-md);
  }
</style>
