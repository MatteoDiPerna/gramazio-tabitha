---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/layout/PageHero.astro';
import Card from '@/components/ui/Card.astro';
import CallPopover from '@/components/ui/CallPopover.astro';
import { siteConfig } from '@/config/site.config';
import { staticPageHeroes } from '@/content/pageHeroes';

const contactHero = staticPageHeroes.contatti;

const { address } = siteConfig;
const addressLine1 = address.street;
const addressLine2 = `${address.city}, ${address.postalCode}, ${address.province}`;
const addressLine3 = address.country === 'IT' ? 'Italia' : address.country;

const mapsSearch = encodeURIComponent(
  `${address.street}, ${address.postalCode} ${address.city} ${address.province}, Italia`,
);
const mapsEmbedSrc = `https://www.google.com/maps?q=${mapsSearch}&z=16&hl=it&output=embed`;
const mapsDirectionsHref = `https://www.google.com/maps/search/?api=1&query=${mapsSearch}`;
---

<BaseLayout title="Contatti" description="Telefono, email e indirizzo dell'azienda agricola.">
  <PageHero title={contactHero.title} lead={contactHero.lead} imageSrc={contactHero.image} />

  <div class="contact-page">
    <section class="contact-page__details" aria-label="Recapiti">
      <div class="container contact-page__grid">
        <Card class="contact-block">
          <div class="contact-block__main">
            <span class="contact-block__icon" aria-hidden="true">📍</span>
            <h2 class="contact-block__label">Indirizzo</h2>
            <p class="contact-block__value">
              {addressLine1}<br />
              {addressLine2}<br />
              {addressLine3}
            </p>
          </div>
        </Card>

        <Card class="contact-block">
          <div class="contact-block__main">
            <span class="contact-block__icon" aria-hidden="true">📞</span>
            <h2 class="contact-block__label">Telefono</h2>
            <p class="contact-block__value">
              <a href={`tel:${siteConfig.phoneTel}`}>{siteConfig.phoneDisplay}</a>
            </p>
          </div>
          <CallPopover variant="button" class="contact-block__call-popover" />
        </Card>

        <Card class="contact-block">
          <div class="contact-block__main">
            <span class="contact-block__icon" aria-hidden="true">✉</span>
            <h2 class="contact-block__label">E mail</h2>
            <p class="contact-block__value">
              <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
            </p>
          </div>
        </Card>
      </div>
    </section>

    <section class="contact-map layout-bleed" aria-label="Mappa sede">
      <iframe
        class="contact-map__frame"
        title={`Mappa — ${siteConfig.name}, ${addressLine1}, ${address.city}`}
        src={mapsEmbedSrc}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      />
      <p class="contact-map__fallback container">
        <a href={mapsDirectionsHref} target="_blank" rel="noopener noreferrer">
          Apri indicazioni stradali in Google Maps
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    background: var(--color-bg);
  }

  .contact-page__details {
    padding: 0 0 var(--space-2xl);
  }

  .contact-page__grid {
    display: grid;
    gap: var(--space-lg);
    text-align: center;
    width: 100%;
    max-width: var(--content-max);
    margin-inline: auto;
    align-items: stretch;
  }

  @media (min-width: 768px) {
    .contact-page__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-lg);
      row-gap: var(--space-lg);
    }
  }

  .contact-block:global(.card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    text-align: center;
  }

  .contact-block__main {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    min-width: 0;
    flex: 1 1 auto;
  }

  .contact-block__icon {
    display: block;
    font-size: 1.5rem;
    margin-bottom: var(--space-sm);
  }

  .contact-block__label {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-primary);
    margin: 0 0 var(--space-md);
  }

  .contact-block__value {
    margin: 0;
    width: 100%;
    max-width: 100%;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-text);
    overflow-wrap: anywhere;
    word-break: break-word;
    hyphens: auto;
  }

  .contact-block__value a {
    display: inline-block;
    max-width: 100%;
    text-decoration: none;
    color: inherit;
    overflow-wrap: anywhere;
    word-break: break-word;
  }

  .contact-block__value a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .contact-block__call-popover {
    flex-shrink: 0;
    margin-top: auto;
    padding-top: var(--space-lg);
    width: 100%;
    max-width: 12rem;
  }

  .contact-map {
    position: relative;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .contact-map__frame {
    display: block;
    width: 100%;
    height: clamp(16rem, 42vh, 28rem);
    border: 0;
    filter: grayscale(0.15) contrast(0.98);
  }

  .contact-map__fallback {
    margin: 0;
    padding: var(--space-sm) 0 var(--space-md);
    text-align: center;
    font-size: 0.875rem;
  }

  .contact-map__fallback a {
    color: var(--color-text-muted);
  }
</style>
