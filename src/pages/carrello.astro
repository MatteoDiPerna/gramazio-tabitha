---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { CartPage } from '@/components/cart/CartPage';

const heroTitle = 'Riepilogo ordine';
const heroLead = 'Componi la richiesta e inviala via WhatsApp o email';
---

<BaseLayout
  title="Riepilogo ordine"
  description="Componi la richiesta d'ordine e inviala via WhatsApp o email."
  hideWhatsAppFab
  bodyClass="page-carrello"
>
  <PageHero title={heroTitle} lead={heroLead} size="compact" />
  <PageContainer class="page--cart">
    <CartPage client:load />
  </PageContainer>
</BaseLayout>
