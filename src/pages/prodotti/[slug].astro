---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import PageHero from '@/components/layout/PageHero.astro';
import ProductDetail from '@/components/catalog/ProductDetail.astro';
import { getProductBySlug, getPublishedProducts, getRelatedProducts } from '@/domain/catalog';
import { resolveProductImageSrc } from '@/domain/catalog/productImage';
import { buildProductJsonLd } from '@/domain/seo/structured-data';

export function getStaticPaths() {
  return getPublishedProducts().map((product) => ({
    params: { slug: product.slug },
  }));
}

const { slug } = Astro.params;
const product = slug ? getProductBySlug(slug) : undefined;

if (!product) {
  return Astro.redirect('/catalogo');
}

const allPublished = getPublishedProducts();
const related = getRelatedProducts(product, allPublished, 3);
const imageSrc = resolveProductImageSrc(product);
const heroLead = product.shortDescription;
---

<BaseLayout
  title={product.name}
  description={product.shortDescription}
  canonicalPath={`/prodotti/${product.slug}`}
  ogType="product"
  ogImagePath={imageSrc}
  jsonLdNodes={[buildProductJsonLd(product)]}
>
  <PageHero title={product.name} lead={heroLead} imageSrc={imageSrc} />
  <PageContainer>
    <ProductDetail product={product} related={related} />
  </PageContainer>
</BaseLayout>
