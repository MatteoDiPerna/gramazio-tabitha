---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { siteConfig } from '@/config/site.config';
import { staticPageHeroes } from '@/content/pageHeroes';

const hero = staticPageHeroes.noteLegali;
const { legal } = siteConfig;
---

<BaseLayout title="Note legali" description="Informazioni legali e note sul sito.">
  <PageHero title={hero.title} lead={hero.lead} imageSrc={hero.image} />
  <PageContainer prose>
    <p class="legal-notice">
      <strong>Testi legali.</strong> Privacy e cookie restano bozze tecniche da revisione
      professionale; i dati anagrafici sotto sono quelli comunicati per il sito.
    </p>
    <h2>Titolare</h2>
    <p>
      <strong>{siteConfig.name}</strong>
      <br />
      Ragione sociale / denominazione: {legal.businessName}
      <br />
      Partita IVA: {legal.vatNumber}
      <br />
      Codice ATECO: {legal.ateco}
    </p>
    <p>
      {siteConfig.address.street}, {siteConfig.address.postalCode}{' '}
      {siteConfig.address.city} ({siteConfig.address.province}), {siteConfig.address.country}
    </p>
    <p>
      Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <br />
      PEC: <a href={`mailto:${legal.pec}`}>{legal.pec}</a>
      <br />
      Telefono: <a href={`tel:${siteConfig.phoneTel}`}>{siteConfig.phoneDisplay}</a>
    </p>
    <h2>Prezzi e ordini</h2>
    <p>
      I prezzi indicati sul sito, quando presenti, hanno valore <strong>indicativo</strong> fino a
      conferma scritta dell&apos;ordine da parte dell&apos;azienda. L&apos;invio di una richiesta
      d&apos;ordine non costituisce contratto di vendita.
    </p>
    <p>
      Per l&apos;informativa sul trattamento dei dati personali vedi la pagina{' '}
      <a href="/privacy">Privacy</a>.
    </p>
  </PageContainer>
</BaseLayout>

<style>
  .legal-notice {
    padding: var(--space-md);
    background: var(--color-surface-sunken, #f3f0e8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
</style>
