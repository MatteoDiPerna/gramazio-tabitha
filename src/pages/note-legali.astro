---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import PageHero from '@/components/layout/PageHero.astro';
import LegalHtml from '@/components/legal/LegalHtml.astro';
import { siteConfig } from '@/config/site.config';
import { staticPageHeroes } from '@/content/pageHeroes';
import { getEditorial } from '@/cms/editorial';

const hero = staticPageHeroes.noteLegali;
const { legal: legalEntity } = siteConfig;
const legal = getEditorial().legal.noteLegali;
---

<BaseLayout title="Note legali" description="Informazioni legali e note sul sito.">
  <PageHero title={hero.title} lead={hero.lead} imageSrc={hero.image} />
  <PageContainer prose>
    <p class="legal-notice" set:html={legal.noticeHtml} />
    <h2>Titolare</h2>
    <p>
      <strong>{siteConfig.name}</strong>
      <br />
      Ragione sociale / denominazione: {legalEntity.businessName}
      <br />
      Partita IVA: {legalEntity.vatNumber}
      <br />
      Codice ATECO: {legalEntity.ateco}
    </p>
    <p>
      {siteConfig.address.street}, {siteConfig.address.postalCode}{' '}
      {siteConfig.address.city} ({siteConfig.address.province}), {siteConfig.address.country}
    </p>
    <p>
      Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
      <br />
      PEC: <a href={`mailto:${legalEntity.pec}`}>{legalEntity.pec}</a>
      <br />
      Telefono: <a href={`tel:${siteConfig.phoneTel}`}>{siteConfig.phoneDisplay}</a>
    </p>
    <LegalHtml html={legal.bodyHtml} />
    {
      legal.lastReviewedAt ? (
        <p class="legal-reviewed">
          <small>Ultima revisione contenuto: {legal.lastReviewedAt}</small>
        </p>
      ) : null
    }
  </PageContainer>
</BaseLayout>

<style>
  .legal-notice {
    padding: var(--space-md);
    background: var(--color-surface-sunken, #f3f0e8);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }
  .legal-reviewed {
    margin-top: var(--space-lg);
    color: var(--color-text-muted, #666);
  }
</style>
