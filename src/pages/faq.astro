---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { faqItems } from '@/content/faq';
import { staticPageHeroes } from '@/content/pageHeroes';

const faqHero = staticPageHeroes.faq;
---

<BaseLayout
  title="FAQ ordini e spedizioni"
  description="Come ordinare, spedizioni e pagamenti — Azienda Agricola Gramazio Tabitha."
>
  <PageHero title={faqHero.title} lead={faqHero.lead} imageSrc={faqHero.image} />
  <PageContainer centered prose>
    <dl class="faq">
      {
        faqItems.map((item) => (
          <div>
            <dt>{item.question}</dt>
            <dd set:html={item.answerHtml} />
          </div>
        ))
      }
    </dl>
  </PageContainer>
</BaseLayout>

<style>
  .faq {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-lg);
  }

  .faq dt {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .faq dd {
    margin: 0 auto;
    color: var(--color-text-muted);
    max-width: 40rem;
  }
</style>
