---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import { faqIntro, faqItems } from '@/content/faq';
---

<BaseLayout
  title="FAQ ordini e spedizioni"
  description="Come ordinare, spedizioni e pagamenti — Azienda Agricola Gramazio Tabitha."
>
  <PageContainer centered prose>
    <h1 class="page-title">Ordini, spedizioni e pagamenti</h1>
    <p class="lead">{faqIntro}</p>
    <dl class="faq">
      {
        faqItems.map((item) => (
          <div>
            <dt>{item.question}</dt>
            <dd set:html={item.answerHtml} />
          </div>
        ))
      }
    </dl>
  </PageContainer>
</BaseLayout>

<style>
  .faq {
    margin-top: var(--space-xl);
    display: grid;
    gap: var(--space-lg);
  }

  .faq dt {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-primary);
    margin-bottom: var(--space-sm);
  }

  .faq dd {
    margin: 0 auto;
    color: var(--color-text-muted);
    max-width: 40rem;
  }
</style>
