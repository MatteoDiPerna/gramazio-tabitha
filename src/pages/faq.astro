---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageContainer from '@/components/layout/PageContainer.astro';
import PageHero from '@/components/layout/PageHero.astro';
import { FaqAccordion } from '@/components/faq/FaqAccordion';
import { faqIntro, faqItems } from '@/content/faq';
import { staticPageHeroes } from '@/content/pageHeroes';
import { buildFaqPageJsonLd } from '@/domain/seo/structured-data';

const faqHero = staticPageHeroes.faq;
---

<BaseLayout
  title="FAQ ordini e spedizioni"
  description="Come ordinare, spedizioni e pagamenti — Azienda Agricola Gramazio Tabitha."
  jsonLdNodes={[buildFaqPageJsonLd(faqItems)]}
>
  <PageHero title={faqHero.title} lead={faqHero.lead} imageSrc={faqHero.image} />
  <PageContainer centered>
    <FaqAccordion client:load items={faqItems} intro={faqIntro} />
    <nav class="faq-links" aria-label="Link utili">
      <a href="/carrello">Carrello</a>
      <a href="/contatti">Contatti</a>
      <a href="/privacy">Privacy</a>
    </nav>
  </PageContainer>
</BaseLayout>

<style>
  .faq-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-2xl);
    font-weight: 600;
  }

  .faq-links a {
    color: var(--color-primary);
    text-decoration: none;
  }

  .faq-links a:hover {
    text-decoration: underline;
  }
</style>
