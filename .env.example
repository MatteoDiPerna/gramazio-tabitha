# URL pubblico del sito (senza slash finale). Usato in build per sitemap e import.meta.env.SITE
SITE_URL=https://gramazio-tabitha.netlify.app

# Pre-staging: 1 = noindex su tutte le pagine (meta robots)
# SITE_NOINDEX=1

# Sanity — import/sync dalla root (npm run cms:import | cms:sync)
# SANITY_PROJECT_ID= stesso ID di SANITY_STUDIO_PROJECT_ID in backoffice/.env
# SANITY_DATASET=production
# SANITY_API_TOKEN= token Editor (import) o Viewer (solo sync) — solo in .env locale / Vercel, mai in git

# Opzionale: dopo sync locale, trigger deploy Vercel
# VERCEL_DEPLOY_HOOK=
# CMS_TRIGGER_DEPLOY=1
