{
  "name": "gramazio-tabitha",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:clean": "node scripts/clean-vite-cache.mjs && astro dev",
    "prebuild": "npm run cms:sync",
    "build": "astro build",
    "cms:snapshot": "tsx scripts/cms/snapshot-from-repo.ts",
    "cms:sync": "tsx scripts/cms/sync-from-sanity.ts",
    "cms:import": "tsx scripts/cms/import-to-sanity.ts",
    "backoffice:dev": "npm run dev --prefix backoffice",
    "backoffice:deploy": "npm run deploy --prefix backoffice",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:release": "node scripts/check-release.mjs",
    "smoke:dist": "node scripts/smoke-dist.mjs",
    "verify": "npm test && npm run lint && npm run build && npm run smoke:dist && npm run check:release",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/react": "^7.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@sanity/client": "^7.12.0",
    "@sanity/image-url": "^1.2.0",
    "@eslint/js": "^9.39.1",
    "tsx": "^4.20.6",
    "eslint": "^9.39.1",
    "eslint-plugin-astro": "^1.5.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript-eslint": "^8.46.4",
    "vitest": "^5.0.3"
  }
}
